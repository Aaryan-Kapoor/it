{
  "name": "it-monorepo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "generate": "node packages/runtime/build.mjs && npm run -s build -w web && node packages/cli/build.mjs",
    "typecheck": "tsc -b packages/protocol packages/runtime packages/cli packages/content && tsc -p convex --noEmit && tsc -p web --noEmit",
    "test": "vitest run",
    "test:hermes": "cd addons/hermes && python3 -m unittest discover -p \"test_*.py\"",
    "check": "biome check .",
    "check:ci": "biome ci --error-on-warnings .",
    "check:secrets": "node scripts/secrets.mjs",
    "check:history": "node scripts/secrets.mjs --history",
    "notices": "node scripts/notices.mjs",
    "check:notices": "node scripts/notices.mjs --check",
    "format": "biome check --write ."
  },
  "dependencies": {
    "convex": "^1.46.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "convex-test": "^0.0.38",
    "jsdom": "^30.1.1",
    "playwright": "^1.61.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
